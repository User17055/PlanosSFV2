APP_NAME="São Francisco"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8765
APP_DEMO=false

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vindi Service v1: leave disabled until sandbox/account mapping is approved.
VINDI_ENABLED=false
VINDI_BASE_URL=https://sandbox-app.vindi.com.br/api/v1
VINDI_API_KEY=
VINDI_ACCOUNT=central
VINDI_WEBHOOK_USER=
VINDI_WEBHOOK_PASSWORD=
VINDI_TIMEOUT=15
VINDI_ALLOW_CREATION=false
VINDI_PAYMENT_METHOD_CODE=bank_slip
# Methods the tutor chooses at checkout ("vindi_code:Label"), with the codes registered in the Vindi account.
VINDI_PAYMENT_METHODS="credit_card:Cartão de crédito,pix:PIX,bolepix:Bolepix (boleto com PIX)"
VINDI_CHECKOUT_ENABLED=false
VINDI_CODE_PREFIX=sao-francisco
VINDI_CHECKOUT_PLANS={}
VINDI_PAYMENT_HOSTS=app.vindi.com.br,sandbox-app.vindi.com.br

# Private server-to-server connection from the institutional site. Never expose this key to JS.
SITE_API_ENABLED=false
SITE_API_KEY=
SITE_PUBLIC_URL=https://saofrancisco.vet.br
SITE_TOKEN_HOURS=24

# Private paper-contract uploads. Production must run ClamAV and enable scanning.
CONTRACT_MAX_UPLOAD_KB=10240
CONTRACT_REQUIRE_ANTIVIRUS=false
CONTRACT_CLAMD_SOCKET=tcp://127.0.0.1:3310

# Product rules require approval; demo opt-in is explicit above.
COMMERCIAL_RULES_APPROVED=false
PAPER_CONTRACTS_ENABLED=false
FINANCIAL_MAX_AGE_MINUTES=60
PROPOSAL_VALIDITY_HOURS=48
# Monthly bills: generated on day 1, due on day 10; contracts closed after day 25 skip a month.
BILLING_GENERATION_DAY=1
BILLING_DUE_DAY=10
BILLING_CUTOFF_DAY=25
BENEFIT_RESERVATION_MINUTES=30
