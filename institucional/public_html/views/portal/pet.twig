{% extends 'portal/layout.twig' %}
{% block title %}Cadastrar pet{% endblock %}
{% block content %}<section class="panel narrow-panel"><span class="eyebrow">MAIS UM AMIGO NA FAMÍLIA</span><h1>Cadastre seu pet.</h1><form class="portal-form" method="post" action="{{path('portal_pet')}}"><input type="hidden" name="_token" value="{{csrf}}"><div class="form-grid"><label>Nome <span>*</span><input name="name" required maxlength="100" value="{{old.name|default('')}}"></label><label>Espécie<select name="species"><option value="dog">Cão</option><option value="cat" {{old.species|default('')=='cat'?'selected':''}}>Gato</option></select></label><label>Nascimento <span>*</span><input name="birth_date" type="date" required max="{{'now'|date('Y-m-d')}}" value="{{old.birth_date|default('')}}"></label><label>Raça <span>*</span><input name="breed" required maxlength="100" value="{{old.breed|default('')}}" placeholder="Ex.: SRD (sem raça definida)"></label><label>Cor / pelagem <span>*</span><input name="color" required maxlength="100" value="{{old.color|default('')}}"></label><label>Sexo <span>*</span><select name="sex" required><option value="">Selecione</option><option value="male" {{old.sex|default('')=='male'?'selected':''}}>Macho</option><option value="female" {{old.sex|default('')=='female'?'selected':''}}>Fêmea</option></select></label><label>Castrado? <span>*</span><select name="neutered" required><option value="">Selecione</option><option value="1" {{old.neutered|default('')=='1'?'selected':''}}>Sim</option><option value="0" {{old.neutered|default('')=='0'?'selected':''}}>Não</option></select></label></div><button class="button button-primary" data-busy="Salvando...">Salvar meu pet</button><a class="text-link" href="{{path('portal_home')}}">Voltar ao meu espaço</a></form></section>{% endblock %}
