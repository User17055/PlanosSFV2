{% extends 'portal/layout.twig' %}
{% block title %}Cadastrar pet{% endblock %}
{% block content %}<section class="panel narrow-panel"><span class="eyebrow">MAIS UM AMIGO NA FAMÍLIA</span><h1>Cadastre seu pet.</h1><form class="portal-form" method="post" action="{{path('portal_pet')}}"><input type="hidden" name="_token" value="{{csrf}}"><div class="form-grid"><label>Nome <span>*</span><input name="name" required maxlength="100" value="{{old.name|default('')}}"></label><label>Espécie<select name="species"><option value="dog">Cão</option><option value="cat" {{old.species|default('')=='cat'?'selected':''}}>Gato</option></select></label><label>Nascimento <span>*</span><input name="birth_date" type="date" required max="{{'now'|date('Y-m-d')}}" value="{{old.birth_date|default('')}}"></label><label>Raça<input name="breed" maxlength="100" value="{{old.breed|default('')}}"></label><label>Cor / pelagem<input name="color" maxlength="100" value="{{old.color|default('')}}"></label><label>Sexo<select name="sex"><option value="unknown">Não informado</option><option value="male">Macho</option><option value="female">Fêmea</option></select></label></div><button class="button button-primary" data-busy="Salvando...">Salvar meu pet</button><a class="text-link" href="{{path('portal_home')}}">Voltar ao meu espaço</a></form></section>{% endblock %}
