{% macro money(cents) %}R$ {{(cents / 100)|number_format(2, ',', '.')}}{% endmacro %}
{% macro benefit_tag(b) %}{% set tags = [] %}{% if b.coverage_type|default('') == 'discount' %}{% set tags = tags|merge([b.discount_basis_points|default(0) ? (b.discount_basis_points / 100)|number_format(0, ',', '.') ~ '% de desconto' : 'Desconto']) %}{% endif %}{% if (b.quantity_limit ?? null) is not null %}{% set tags = tags|merge([(b.quantity_limit ~ ' ' ~ {'contract_year':'por ano','calendar_month':'por mês','monthly_cycle':'por ciclo mensal','lifetime':'na vigência'}[b.period_type|default('')]|default(''))|trim]) %}{% endif %}{{ tags ? tags|join(' · ') : 'Incluso' }}{% endmacro %}
{% macro cycle(value) %}{{{'monthly':'por mês','annual':'por ano','yearly':'por ano','one_time':'pagamento único'}[value]|default(value)}}{% endmacro %}
{% macro status(value) %}<span class="status status-{{value}}">{{{'active':'Ativo','awaiting_regularization':'Aguardando ativação','suspended':'Suspenso','scheduled_cancellation':'Encerramento agendado','cancelled':'Cancelado','ended':'Encerrado','pending':'Pendente','paid':'Pago','partial':'Pagamento parcial','refunded':'Estornado','disputed':'Em contestação','valid':'Válido','resolved':'Concluído'}[value]|default('Em acompanhamento')}}</span>{% endmacro %}
