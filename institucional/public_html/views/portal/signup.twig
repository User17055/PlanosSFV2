{% extends 'portal/layout.twig' %}
{% block title %}{{offer ? 'Contratar ' ~ offer.name : 'Criar meu acesso'}}{% endblock %}
{% block body_class %}pagina-contratacao{% endblock %}
{% block content %}
<div class="contratacao-hero{{offer ? ' com-foto'}}"><span class="eyebrow">UM NOVO CAPÍTULO DE CUIDADO</span><h1>Vamos cuidar do seu melhor amigo.</h1><p>Cadastre seus dados e os do pet. Depois, você confere o contrato antes de assinar.</p>
{% if offer %}<div class="contratacao-hero-foto"><img src="{{asset('imgs/banner-cao-4.png')}}" alt=""></div>{% endif %}</div>
<ol class="journey" aria-label="Etapas da contratação"><li class="current" aria-current="step"><span>1</span> Cadastro</li><li><span>2</span> Contrato e assinatura</li><li><span>3</span> Pagamento e ativação</li></ol>
<div class="portal-columns contratacao"><section class="panel contratacao-form"><form method="post" action="{{offer ? path('portal_subscribe',{'code':offer.code}) : path('portal_signup')}}" class="portal-form" data-postal-url="{{path('portal_postal',{'zip':'00000000'})}}"><input type="hidden" name="_token" value="{{csrf}}">
<div class="form-section"><div class="section-heading"><span class="section-number">01</span><div><h2>Seus dados</h2><p>Quem vai acompanhar cada etapa desse cuidado.</p></div></div>
<div class="form-grid"><label class="span-2">Nome completo <span>*</span><input name="name" required minlength="3" maxlength="180" autocomplete="name" value="{{old.name|default('')}}"></label>
<label>CPF <span>*</span><input name="document" required inputmode="numeric" maxlength="14" autocomplete="off" value="{{old.document|default('')}}"></label><label>RG<input name="rg" maxlength="40" value="{{old.rg|default('')}}"></label>
<label>E-mail <span>*</span><input name="email" type="email" required maxlength="180" autocomplete="email" value="{{old.email|default('')}}"></label><label>Celular <span>*</span><input name="phone" type="tel" required maxlength="30" autocomplete="tel" value="{{old.phone|default('')}}"></label></div></div>
<div class="form-section"><div class="section-heading"><span class="section-number">02</span><div><h2>Endereço</h2><p>Comece pelo CEP para buscarmos o endereço.</p></div></div>
<div class="form-grid"><label>CEP <span>*</span><input name="zip" required inputmode="numeric" maxlength="9" autocomplete="postal-code" value="{{old.zip|default('')}}"><small data-postal-status role="status">Digite o CEP para buscar o endereço.</small></label><div class="field-spacer"></div>
<label>Rua / avenida <span>*</span><input name="street" required maxlength="200" autocomplete="address-line1" value="{{old.street|default('')}}"></label><label>Número <span>*</span><input name="number" required maxlength="30" value="{{old.number|default('')}}"></label>
<label>Complemento<input name="complement" maxlength="120" autocomplete="address-line2" value="{{old.complement|default('')}}"></label><label>Bairro <span>*</span><input name="neighborhood" required maxlength="150" value="{{old.neighborhood|default('')}}"></label>
<label>Cidade <span>*</span><input name="city" required maxlength="150" autocomplete="address-level2" value="{{old.city|default('')}}"></label><label>UF <span>*</span><input name="state" required minlength="2" maxlength="2" autocomplete="address-level1" value="{{old.state|default('')}}"></label></div></div>
<div class="form-section"><div class="section-heading"><span class="section-number">03</span><div><h2>Seu pet</h2><p>O plano e seus benefícios são individuais.</p></div></div>
{% include 'portal/_pet-fields.twig' %}</div>
<div class="form-section"><div class="section-heading"><span class="section-number">04</span><div><h2>Seu acesso</h2><p>Para acompanhar contrato, pagamentos e benefícios.</p></div></div>
<div class="form-grid"><label>Crie uma senha <span>*</span><input name="password" type="password" required minlength="12" autocomplete="new-password"><small>Use pelo menos 12 caracteres.</small></label><label>Confirme a senha <span>*</span><input name="password_confirmation" type="password" required minlength="12" autocomplete="new-password"></label>
<label>Como conheceu a São Francisco?<select name="acquisition_source"><option value="">Prefiro não informar</option><option value="direct">Já conheço a clínica</option><option value="referral">Indicação</option><option value="instagram">Instagram</option><option value="facebook">Facebook</option><option value="google">Google</option><option value="other">Outro</option></select></label><label>Quem indicou? <span class="optional">(opcional)</span><input name="referrer_name" maxlength="180" value="{{old.referrer_name|default('')}}"></label></div></div>
<label class="checkbox-label"><input type="checkbox" name="privacy_accepted" value="1" required><span>Autorizo o uso dos dados informados para meu cadastro e a contratação dos serviços São Francisco. O cadastro não representa assinatura do contrato nem autorização de marketing.</span></label>
<button class="button button-primary" data-busy="Salvando seu cadastro...">{{offer ? 'Continuar para o contrato' : 'Criar meu acesso'}} <span aria-hidden="true">→</span></button>
<p class="auth-bottom">Já tem cadastro? <a href="{{path('portal_login')}}">Entre com seu acesso</a>.</p></form></section>
{% if offer %}{% include 'portal/_offer.twig' %}{% else %}<aside class="panel offer-summary"><span class="eyebrow">O CUIDADO COMEÇA AQUI</span><h2>Um espaço para sua família.</h2><p>Cadastre seu pet e acompanhe seus planos, contratos, pagamentos e benefícios.</p><img src="{{asset('imgs/banner-cao-4.png')}}" alt="Seu melhor amigo" class="summary-dog"><p class="fine-print">Depois de criar seu acesso, você poderá escolher um plano para contratar.</p></aside>{% endif %}</div>
{% endblock %}
