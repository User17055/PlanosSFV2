{% extends 'portal/layout.twig' %}
{% block title %}{{reset?'Criar nova senha':'Recuperar acesso'}}{% endblock %}
{% block content %}<section class="panel narrow-panel"><span class="eyebrow">SEU ESPAÇO ESTÁ AQUI</span><h1>{{reset?'Crie sua nova senha.':'Vamos recuperar seu acesso.'}}</h1><p>{{reset?'Use uma senha com pelo menos 12 caracteres.':'Informe seu e-mail para receber as instruções.'}}</p><form class="portal-form" method="post" action="{{reset?path('portal_reset'):path('portal_forgot')}}"><input type="hidden" name="_token" value="{{csrf}}">{% if reset %}<input type="hidden" name="token" value="{{reset_token}}">{% endif %}<label>E-mail<input name="email" type="email" required autocomplete="email" value="{{reset?reset_email:old.email|default('')}}"></label>{% if reset %}<label>Nova senha<input type="password" name="password" required minlength="12" autocomplete="new-password"></label><label>Confirme a nova senha<input type="password" name="password_confirmation" required minlength="12" autocomplete="new-password"></label>{% endif %}<button class="button button-primary" data-busy="Aguarde...">{{reset?'Salvar nova senha':'Enviar instruções'}}</button><a class="text-link" href="{{path('portal_login')}}">Voltar para entrar</a></form></section>{% endblock %}
