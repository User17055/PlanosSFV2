{% extends 'portal/layout.twig' %}
{% import 'portal/_helpers.twig' as ui %}
{% block title %}Meu espaço{% endblock %}
{% block content %}
<div class="dashboard-heading"><div><span class="eyebrow">SEU ESPAÇO DE CUIDADO</span><h1>Olá, {{account.user.name|split(' ')|first}}<span class="heading-dot">.</span></h1><p>Vamos acompanhar quem faz sua vida mais feliz.</p></div><a class="button button-primary" href="{{path('web_planos')}}">Contratar um plano</a></div>
<nav class="dashboard-nav" aria-label="Seções da área do cliente"><a href="#meus-planos">Meus planos</a><a href="#meus-pagamentos">Pagamentos</a><a href="#meus-pets">Meus pets</a></nav>
{% if account.financial.status=='blocked' %}<div class="notice notice-error"><strong>Há pagamentos vencidos.</strong><p>Os benefícios ficam bloqueados até a confirmação da regularização. <a href="#meus-pagamentos">Consultar pagamentos</a>.</p></div>{% elseif account.financial.status=='pending' %}<div class="notice notice-info"><strong>Seus pagamentos estão em conferência.</strong><p>A liberação dos benefícios depende da confirmação financeira e das condições de cada contrato.</p></div>{% endif %}
{% if account.proposals %}<section class="section-gap"><h2 class="section-title">Seu cuidado está quase pronto.</h2>{% for p in account.proposals %}<div class="pending-proposal panel"><div><span class="eyebrow">CONTINUE DE ONDE PAROU</span><h3>{{p.name}} para {{p.pet_name}}</h3><p>Confira os dados e leia o contrato para continuar.</p></div><a class="button button-primary" href="{{path('portal_proposal',{'id':p.id})}}">Revisar contrato</a></div>{% endfor %}</section>{% endif %}
<section id="meus-planos" class="section-gap anchor-section"><div class="section-title-row"><div><span class="eyebrow">O CUIDADO QUE ACOMPANHA</span><h2>Meus planos e contratos</h2></div><span>{{account.subscriptions|length}} contratação(ões)</span></div>
<div class="subscription-grid">{% for s in account.subscriptions %}<article class="panel subscription-card"><div class="subscription-heading"><span class="pet-initial">{{s.pet_name|slice(0,1)|upper}}</span><div><h3>{{s.pet_name}}</h3><p>{{s.name}}</p></div>{{ui.status(s.status)}}</div><div class="contract-meta"><span>Contrato <strong>{{s.number}}</strong></span>{% if s.effective_start_at %}<span>Início da vigência <strong>{{s.effective_start_at|date('d/m/Y')}}</strong></span>{% endif %}</div>
{% if s.impediments and s.status not in ['cancelled','ended'] %}<div class="subscription-notices">{% for issue in s.impediments %}{% if issue.code not in ['CUSTOMER_OVERDUE','FINANCIAL_VERIFICATION_PENDING','SUBSCRIPTION_NOT_ACTIVE'] %}<p>{{issue.message}}</p>{% endif %}{% endfor %}</div>{% endif %}
<div class="button-row">{% if s.document_id %}<a class="button button-secondary button-small" href="{{path('portal_document',{'id':s.document_id})}}" target="_blank" rel="noopener">Ver contrato PDF <span aria-hidden="true">↗</span></a>{% elseif s.document_status!='valid' %}<a class="button button-secondary button-small" href="{{path('portal_proposal',{'id':s.proposal_id})}}">Preparar meu contrato</a>{% endif %}
{% if s.can_checkout %}<form method="post" action="{{path('portal_checkout',{'id':s.id})}}"><input type="hidden" name="_token" value="{{csrf}}"><button class="button button-primary button-small" data-busy="Preparando...">Pagar com Vindi</button></form>{% endif %}</div>
<details class="benefit-details"><summary>Benefícios e carências <span aria-hidden="true">＋</span></summary><ul>{% for b in s.benefits %}<li><div><strong>{{b.name}}</strong>{% if b.description %}<p>{{b.description}}</p>{% endif %}{% if b.available_from and not b.eligible %}<small>Liberação prevista: {{b.available_from|date('d/m/Y')}}</small>{% endif %}</div><span class="benefit-state {{b.eligible?'is-available':''}}">{% if b.eligible %}{{b.remaining is null?'Disponível':'Saldo: '~b.remaining}}{% else %}Acompanhar liberação{% endif %}</span></li>{% else %}<li>Confira as condições completas no contrato.</li>{% endfor %}</ul></details>
{% if s.cancellation_status %}<p class="fine-print cancellation-note">Solicitação de cancelamento: {{ui.status(s.cancellation_status)}}</p>{% elseif s.can_cancel %}<details class="cancellation-details"><summary>Solicitar cancelamento</summary><p class="fine-print">A unidade vai conferir a data de encerramento e as cobranças. O envio do pedido não encerra o contrato automaticamente.</p><form method="post" action="{{path('portal_cancel',{'id':s.id})}}" class="portal-form"><input type="hidden" name="_token" value="{{csrf}}"><label>Motivo<textarea name="reason" required minlength="5" maxlength="1000" rows="3"></textarea></label><button class="button button-secondary button-small" data-busy="Enviando solicitação...">Enviar solicitação</button></form></details>{% endif %}</article>
{% else %}<div class="panel empty-state"><span class="round-symbol" aria-hidden="true">♡</span><h3>Uma nova história de cuidado começa aqui.</h3><p>Você ainda não possui planos contratados.</p><a class="button button-primary" href="{{path('web_planos')}}">Conhecer os planos</a></div>{% endfor %}</div></section>
<section id="meus-pagamentos" class="section-gap anchor-section"><div class="section-title-row"><div><span class="eyebrow">TUDO ÀS CLARAS</span><h2>Meus pagamentos</h2></div></div><div class="panel invoices-panel">{% for invoice in account.invoices %}<article class="invoice-row"><div><strong>{{ui.money(invoice.amount_cents)}}</strong><small>Contrato {{invoice.subscription_number}}</small></div><div><span class="meta-label">Vencimento</span><strong>{{invoice.due_at?invoice.due_at|date('d/m/Y'):'A confirmar'}}</strong></div><div>{{ui.status(invoice.status)}}{% if invoice.paid_at %}<small>Confirmado em {{invoice.paid_at|date('d/m/Y')}}</small>{% endif %}</div><div>{% if invoice.can_pay %}<form method="post" action="{{path('portal_invoice',{'id':invoice.id})}}"><input type="hidden" name="_token" value="{{csrf}}"><button class="button button-primary button-small" data-busy="Preparando...">Pagar fatura <span aria-hidden="true">↗</span></button></form>{% elseif invoice.status not in ['paid','cancelled','refunded','disputed'] %}<small>Acompanhe a emissão com sua unidade.</small>{% endif %}</div></article>{% else %}<div class="empty-state"><h3>Nenhuma fatura por aqui.</h3><p>Os pagamentos aparecerão após a contratação.</p></div>{% endfor %}</div></section>
<section id="meus-pets" class="section-gap anchor-section"><div class="section-title-row"><div><span class="eyebrow">QUEM FAZ PARTE DESSA HISTÓRIA</span><h2>Meus pets</h2></div><a class="text-link" href="{{path('portal_pet')}}">+ Cadastrar pet</a></div><div class="pets-grid">{% for pet in account.pets %}<article class="panel pet-card"><span class="pet-initial">{{pet.name|slice(0,1)|upper}}</span><div><h3>{{pet.name}}</h3><p>{{pet.species=='cat'?'Gato':'Cão'}}{{pet.breed?' · '~pet.breed:''}}</p>{% if pet.birth_date %}<small>Nasceu em {{pet.birth_date|date('d/m/Y')}}</small>{% endif %}</div></article>{% else %}<p>Cadastre seu primeiro pet para escolher um plano.</p>{% endfor %}</div></section>
<aside class="portal-help"><div><h2>Estamos por perto.</h2><p>Conte com sua unidade São Francisco para esclarecer dúvidas sobre seu plano e os cuidados do seu pet.</p></div><a class="button button-secondary" href="tel:+551832212021">Falar com a clínica</a></aside>
{% endblock %}
