{% extends 'portal/layout.twig' %}
{% import 'portal/_helpers.twig' as ui %}
{% block title %}Contrato de {{proposal.pet_name}}{% endblock %}
{% block body_class %}pagina-contratacao{% endblock %}
{% block content %}<div class="contratacao-hero com-foto"><span class="eyebrow">{{proposal.accepted?'QUASE LÁ':'CONTRATO E ASSINATURA'}}</span><h1>{{proposal.accepted?'Seu cuidado está a caminho.':'Confira cada detalhe do cuidado.'}}</h1><p>{{proposal.name}} para <strong>{{proposal.pet_name}}</strong> · Proposta {{proposal.number}}</p>
<div class="contratacao-hero-foto"><img src="{{asset('imgs/banner-cao-4.png')}}" alt=""></div></div>
<ol class="journey" aria-label="Etapas da contratação"><li class="complete"><span>✓</span> Escolha do pet</li><li class="{{proposal.accepted?'complete':'current'}}" {% if not proposal.accepted %}aria-current="step"{% endif %}><span>{{proposal.accepted?'✓':'2'}}</span> Contrato e assinatura</li><li class="{{proposal.accepted?'current':''}}" {% if proposal.accepted %}aria-current="step"{% endif %}><span>3</span> Pagamento e ativação</li></ol>
<div class="portal-columns contratacao"><section class="panel contratacao-form contract-panel">
{% if not proposal.accepted %}<div class="section-heading"><span class="section-number">02</span><div><h2>Leia o contrato completo</h2><p>Confira os dados, benefícios, valores, limites e carências.</p></div></div>
{% if proposal.review_pages|default(0) > 0 %}<div class="contract-pages" role="group" aria-label="Contrato com {{proposal.review_pages}} páginas">{% for n in 1..proposal.review_pages %}<img src="{{path('portal_reviewpage',{'id':proposal.id,'page':n})}}" alt="Contrato, página {{n}} de {{proposal.review_pages}}" width="978" height="1265">{% endfor %}</div>{% else %}<div class="pdf-wrapper"><iframe class="contract-frame" title="Contrato preenchido para conferência" src="{{path('portal_review',{'id':proposal.id})}}"></iframe></div>{% endif %}<a class="text-link block-link" href="{{path('portal_review',{'id':proposal.id})}}" target="_blank" rel="noopener">Baixar ou abrir o contrato em PDF</a>
{% if proposal.available %}<form method="post" action="{{path('portal_accept',{'id':proposal.id})}}" class="portal-form section-divider" data-signature-form><input type="hidden" name="_token" value="{{csrf}}"><input type="hidden" name="fingerprint" value="{{proposal.fingerprint}}"><input type="hidden" name="signature_data" data-signature-value><input type="hidden" name="device_info" data-device-info><label>Confirme o nome completo do titular<input name="signer_name" required minlength="3" maxlength="180" autocomplete="name" value="{{old.signer_name|default('')}}" placeholder="{{proposal.signer_name}}"></label><label class="checkbox-label"><input type="checkbox" name="accepted" value="1" required><span>Li o contrato e concordo expressamente com suas condições. Confirmo meus dados e os do pet e desejo assinar este contrato.</span></label><div class="signature-label"><strong>Assine com o dedo ou o mouse na área abaixo</strong><button type="button" class="text-link" data-clear-signature>Limpar assinatura</button></div><canvas class="signature-canvas" data-signature-canvas aria-label="Área para desenhar sua assinatura"></canvas><p class="fine-print" role="alert" data-signature-error hidden>Desenhe sua assinatura antes de confirmar.</p><button class="button button-primary" data-busy="Registrando sua assinatura...">Confirmar e assinar contrato</button><p class="fine-print">A confirmação e a assinatura são obrigatórias. Junto com elas registramos a data e a hora, o endereço IP e os dados do aparelho usado, como prova do aceite. Depois, você segue para o pagamento; a assinatura sozinha não ativa o plano.</p></form>{% else %}<div class="notice notice-warning">Esta proposta não está disponível para assinatura. Consulte os planos disponíveis ou fale com a unidade.</div>{% endif %}
{% else %}<div class="signed-state"><span class="round-symbol" aria-hidden="true">✓</span><h2>Assinatura registrada.</h2><p>Seus dados e as condições aceitas ficam preservados no contrato.</p></div>
{% if proposal.can_checkout %}{% set methods = proposal.payment_methods|default([]) %}
<section class="pay-panel" id="pagamento" aria-labelledby="pay-title">
<div class="pay-head"><span class="pay-step" aria-hidden="true">3</span><div><h2 id="pay-title">Falta só o pagamento</h2><p>Pague a 1ª parcela para validar sua proposta e ativar o plano de <strong>{{proposal.pet_name}}</strong>.</p></div></div>
<div class="pay-total"><div><small>1ª parcela, para pagar agora</small><strong>{{ui.money(proposal.price_cents)}}</strong></div>{% if proposal.next_billing_at is defined %}<p>As próximas parcelas vencem todo mês. A próxima fatura será gerada em {{proposal.next_billing_at|date('d/m/Y')}}, com vencimento até {{proposal.next_due_at|date('d/m/Y')}}.</p>{% endif %}</div>
<form method="post" action="{{path('portal_checkout',{'id':proposal.subscription_id})}}" {% if auto_checkout|default(false) and methods|length <= 1 %}data-auto-submit{% endif %}><input type="hidden" name="_token" value="{{csrf}}">
{% if methods|length > 1 %}<fieldset class="pay-methods"><legend>Escolha como pagar</legend>{% for method in methods %}<label class="pay-method"><input type="radio" name="payment_method" value="{{method.code}}" required {% if (proposal.payment_method ?: methods[0].code) == method.code %}checked{% endif %}><span class="pay-method-icon" aria-hidden="true">{% if method.card %}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="3"/><path d="M2 10h20M6 15h4"/></svg>{% elseif 'bank_slip' in method.code %}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 5v14M8 5v14M12 5v14M16 5v14M20 5v14"/></svg>{% else %}<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 9 9-9 9-9-9z"/><path d="m9 12 3 3 3-3"/></svg>{% endif %}</span><span class="pay-method-text"><strong>{{method.label}}</strong><small>{{ method.card ? 'A 1ª parcela é cobrada agora e as mensalidades seguem automáticas no cartão.' : 'Pague a 1ª parcela agora; as mensalidades chegam por e-mail, com vencimento até o dia 10.' }}</small></span></label>{% endfor %}</fieldset>{% elseif methods|length == 1 %}<input type="hidden" name="payment_method" value="{{methods[0].code}}">{% endif %}
<button class="button button-primary pay-button" data-busy="Preparando pagamento...">Pagar {{ui.money(proposal.price_cents)}} agora</button></form>
{% if auto_checkout|default(false) %}<p class="fine-print" role="status">Levando você para o pagamento seguro…</p>{% endif %}
<ul class="pay-trust"><li>Você paga na página segura da Vindi.</li><li>Depois do pagamento, enviamos o e-mail de confirmação: ao clicar, seu plano é ativado.</li><li>Acompanhe tudo na sua área do cliente, em Faturas.</li></ul>
</section>{% endif %}
{% if proposal.document_id %}<a class="button button-secondary" href="{{path('portal_document',{'id':proposal.document_id})}}" target="_blank" rel="noopener">Abrir meu contrato PDF ↗</a>{% if proposal.document_pages|default(0) > 0 %}<div class="contract-pages section-gap" role="group" aria-label="Contrato assinado com {{proposal.document_pages}} páginas">{% for n in 1..proposal.document_pages %}<img src="{{path('portal_docpage',{'id':proposal.document_id,'page':n})}}" alt="Contrato assinado, página {{n}} de {{proposal.document_pages}}" width="978" height="1265" loading="lazy">{% endfor %}</div>{% else %}<iframe class="contract-frame section-gap" title="Contrato final assinado" src="{{path('portal_document',{'id':proposal.document_id})}}"></iframe>{% endif %}
{% else %}<div class="notice notice-info"><strong>Sua assinatura está salva.</strong><p>Estamos preparando o PDF. Se houver uma falha na conexão, você pode tentar novamente sem assinar outra vez.</p></div><form method="post" action="{{path('portal_generate',{'id':proposal.id})}}" class="portal-form" data-contract-generation><input type="hidden" name="_token" value="{{csrf}}"><p role="status" data-generation-status>Prepare o documento para continuar.</p><button class="button button-primary">Preparar meu contrato</button></form>{% endif %}
{% endif %}</section>
<aside class="offer-summary offer-card" aria-label="Plano escolhido"><div class="offer-card-head"><span class="eyebrow">O CUIDADO ESCOLHIDO</span><h2>{{proposal.name}}</h2></div>
<div class="offer-card-body"><div class="offer-price">{{ui.money(proposal.price_cents)}}<small>{{ui.cycle(proposal.billing_cycle)}}</small></div><ul class="offer-meta"><li>Para {{proposal.pet_name}}</li></ul>
{% if proposal.can_checkout %}<div class="notice notice-success"><strong>Falta só o pagamento.</strong><p>Pague a 1ª parcela para validar sua proposta e ativar o plano.</p></div><a class="button button-primary full-width" href="#pagamento">Ir para o pagamento</a>{% elseif proposal.accepted and proposal.document_id %}<p>Seu contrato está pronto. Consulte os pagamentos e acompanhe a ativação na sua área do cliente.</p>{% else %}<p class="fine-print">Após a assinatura e a preparação do contrato, acompanhe o pagamento para iniciar o cuidado.</p>{% endif %}<p class="fine-print">A ativação depende de contrato válido, pagamento confirmado e das demais condições. As carências seguem o contrato.</p><a class="text-link" href="{{path('portal_home')}}">Ir para meu espaço</a></div></aside></div>{% endblock %}
