<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow"><meta name="referrer" content="no-referrer">
  <meta name="theme-color" content="#0b1936">
  <title>{% block title %}Área do cliente{% endblock %} · São Francisco</title>
  <link rel="icon" href="{{asset('imgs/favicon.png')}}">
  <link rel="stylesheet" href="{{asset('css/portal.css?v=28')}}">
  <script defer src="{{asset('js/portal.js?v=9')}}"></script>
</head>
<body class="sf-portal {% block body_class %}{% endblock %}">
<a class="skip-link" href="#conteudo">Ir para o conteúdo</a>
<header class="portal-header"><a class="portal-brand" href="{{path('web_home')}}"><img src="{{asset('imgs/logo.png')}}" alt="São Francisco — serviços veterinários"><span>ÁREA DO CLIENTE</span></a>
  <nav aria-label="Navegação principal">  {% if logged_in %}<a href="{{path('portal_home')}}">Meu espaço</a><form method="post" action="{{path('portal_logout')}}"><input type="hidden" name="_token" value="{{csrf}}"><button class="portal-nav-button">Sair</button></form>
  {% else %}<a class="portal-nav-button" href="{{path('portal_login')}}">Entrar</a>{% endif %}</nav>
</header>
<main id="conteudo" class="portal-main">
  {% if errors %}<div class="notice notice-error" role="alert"><strong>Confira antes de continuar.</strong><ul>{% for error in errors %}<li>{{error}}</li>{% endfor %}</ul></div>{% endif %}
  {% for message in messages %}<div class="notice notice-success" role="status">{{message}}</div>{% endfor %}
  {% block content %}{% endblock %}
</main>
<footer class="portal-footer"><span>São Francisco · Cuidado em cada fase da vida.</span><a href="tel:+551832212021">Precisa de ajuda? Fale com a clínica</a><span>Seus dados e contratos têm acesso protegido.</span></footer>
</body></html>
