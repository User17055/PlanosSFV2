{% extends 'portal/layout.twig' %}
{% block title %}Entre no seu espaço{% endblock %}
{% block content %}
<div class="portal-auth-layout"><section class="portal-auth-story"><span class="eyebrow">O CUIDADO CONTINUA AQUI</span><h1>Mais perto de quem<br>você ama.</h1><p>Seus pets, seus planos e cada próximo passo, em um só lugar.</p><img src="{{asset('imgs/banner-cao-4.png')}}" alt="Um melhor amigo para cuidar" class="portal-dog"><div class="story-note"><span aria-hidden="true">♡</span> Um espaço para acompanhar uma vida inteira de carinho.</div></section>
<section class="panel auth-panel"><span class="eyebrow">BEM-VINDO DE VOLTA</span><h2>Seu espaço de cuidado.</h2><p>Entre para acompanhar contratos, pagamentos e benefícios dos seus pets.</p>
<form method="post" action="{{path('portal_login')}}" class="portal-form"><input type="hidden" name="_token" value="{{csrf}}">
<label>E-mail<input type="email" name="email" required maxlength="180" autocomplete="email" value="{{old.email|default('')}}"></label>
<label>Senha<input type="password" name="password" required autocomplete="current-password"></label>
<a class="form-side-link" href="{{path('portal_forgot')}}">Esqueci minha senha</a>
<button class="button button-primary" data-busy="Entrando...">Entrar na minha conta <span aria-hidden="true">→</span></button></form>
<div class="auth-bottom">Primeira vez por aqui? <a href="{{path('web_planos')}}">Escolha seu plano</a> ou <a href="{{path('portal_signup')}}">crie seu acesso</a>.</div></section></div>
{% endblock %}
