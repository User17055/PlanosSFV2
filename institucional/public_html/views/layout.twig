<script>
    let etapa = 0;
  let dados = { nome: '', telefone: '', email: '' };

  function abrirChat() {
    document.getElementById('chatBox').style.display = 'flex';
    if (etapa === 0) iniciarConversacao();
  }

  function fecharChat() {
    document.getElementById('chatBox').style.display = 'none';
    etapa = 0;
    dados = { nome: '', telefone: '', email: '' };
    document.getElementById('chatMessages').innerHTML = '';
  }

  function iniciarConversacao() {
    setTimeout(() => adicionarMensagem("Olá! Seja bem-vindo à São Francisco 24h."), 200);
    setTimeout(() => adicionarMensagem("Qual é o seu nome?"), 1000);
  }

  function adicionarMensagem(texto, classe = '') {
    const mensagens = document.getElementById('chatMessages');
    const msg = document.createElement('div');
    msg.className = `chat-message ${classe}`;
    msg.innerText = texto;
    msg.style.marginBottom = '10px';
    msg.style.background = classe === 'user' ? '#25d366' : '#e6e6e6';
    msg.style.color = classe === 'user' ? 'white' : 'black';
    msg.style.padding = '8px 12px';
    msg.style.borderRadius = '12px';
    msg.style.maxWidth = '80%';
    msg.style.fontSize = '14px';
    if (classe === 'user') msg.style.marginLeft = 'auto';
    mensagens.appendChild(msg);
    mensagens.scrollTop = mensagens.scrollHeight;
  }

  function enviarResposta() {
    const input = document.getElementById('userInput');
    const resposta = input.value.trim();
    if (!resposta) return;
    adicionarMensagem(resposta, 'user');

    if (etapa === 0) {
      dados.nome = resposta;
      setTimeout(() => adicionarMensagem("Legal, " + dados.nome + "! Qual é o seu telefone?"), 500);
      etapa++;
    } else if (etapa === 1) {
      dados.telefone = resposta;
      setTimeout(() => adicionarMensagem("Perfeito! Agora, qual é o seu e-mail?"), 500);
      etapa++;
    } else if (etapa === 2) {
      dados.email = resposta;
      document.getElementById('inputFullName').value = dados.nome;
      document.getElementById('inputPhone').value = dados.telefone;
      document.getElementById('inputEmail').value = dados.email;
      setTimeout(() => {
        adicionarMensagem("Ótimo! Vamos iniciar a conversa no WhatsApp...");
        abrirWhatsApp();
      }, 500);
      etapa++;
    }
    input.value = '';
  }

  function abrirWhatsApp() {
    const numeroDestino = "5518996642021";
    const mensagem = `Olá! Me chamo ${dados.nome}. Meu telefone é ${dados.telefone}. Vim pelo site da São Francisco e gostaria de atendimento.`;
    const url = `https://wa.me/${numeroDestino}?text=${encodeURIComponent(mensagem)}`;
    window.open(url, '_blank');
    fecharChat();
  </script>

