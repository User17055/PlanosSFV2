{% extends 'front/layout.twig' %}

{% block content %}


<section id="banner" class="interna">
  <div class="container box-info-banner">
    <div class="box-info">
      <div>
        <h2 data-aos="fade-up" data-aos-delay="200" data-aos-duration="800">Adote um companheiro</h2>
        {{adocoes_info.body|raw}}
      </div>
    </div>
    <div class="box-info-img" data-aos="fade-up"  data-aos-delay="800" data-aos-duration="800">
      <img src="{{asset('imgs/banner-cao-5.png')}}">
    </div>
  </div>
</section>

<section id="quem-somos" class="interna">
  <div class="container">

    <div class="box-animais" data-aos="fade-up" data-aos-delay="0" data-aos-duration="800">

      {% for item in pets %}
        <div class="cada-animal">
          <div class="bix-info">
            <div class="img" style="background-image: url('{{path('upload',{'path':'adocoes','imagem':item.image})}}')"></div>
            <div class="descricao">
              <div class="label-nome"><span>Nome:</span></div>
              <div class="text-nome"><span>{{item.nome}}</span></div>
            </div>
            <div class="cidade">
              <div class="box-label">Cidade:</div>
              <div class="box-txt"><span>{{item.cidade}}</span></div>
            </div>
          </div>
          <a class="box-cada-filhote" href="javascript:void(0);" data-nome="{{item.nome}}" onclick="$('html,body').animate({scrollTop: $('#contato').offset().top - 100}, 1000);">ENTRE EM CONTATO PARA ADOTAR</a>
        </div>
      {% endfor %}



    </div>
    {% include 'front/contato.twig' %}
  </div>
</section>


{% endblock %}


{% block js %}

<script type="text/javascript">
  $(document).ready(function(){
      
      $('.box-cada-filhote').on('click', function(){
          $('#contato').append('<input type="hidden" name="iNomeCao" value="' + $(this).data('nome') + '">');
          $('#contato').find('h3').html('Contato <span> - Adoção do(a) ' + $(this).data('nome') + '</span>');
      });
  });
</script>

{% endblock %}