{% extends 'front/layout.twig' %}

{% block content %}


  <section id="banner" class="interna clinica">
    <div class="container box-info-banner">
      <div class="box-info">
        <div>
          <h2 data-aos="fade-up" data-aos-delay="200" data-aos-duration="800">{{clniica_info.title|raw}}</h2>
          <div class="scroll-ms">
            {{clniica_info.body|raw}}
          </div>
        </div>
      </div>
      <div class="box-info-img" data-aos="fade-up"  data-aos-delay="1000" data-aos-duration="800">
        <img src="{{asset('imgs/banner-cao-3.png')}}">
      </div>
    </div>
    <a class="btn-arrow-down" onclick="$('html,body').animate({scrollTop: $('#quem-somos').offset().top - 100}, 1000);"><i class="fa fa-angle-down"></i></a>
  </section>

  <section id="quem-somos" class="interna">
    <div class="container">

      <div class="box-fotos" data-aos="fade-up"  data-aos-delay="200" data-aos-anchor="#quem-somos" data-aos-duration="800">

        {% for item in unidades %}
          <div class="cada-foto">
            <div class="icon" style="background-image: url({{path('imagem',{'path':'unidades','imagem':item.image})}});">
            </div>
            <div class="descricao">
              <p>{{item.cidade|raw}}</p>
              <p>{{item.endereco|raw}}</p>
            </div>
          </div>
        {% endfor %}

      </div>
      {% include 'front/contato.twig' %}
    </div>
  </section>

{% endblock %}

