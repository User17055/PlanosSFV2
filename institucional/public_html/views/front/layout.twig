<script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("form-whats");

    form.addEventListener("submit", function (event) {
      event.preventDefault();

      const nome = document.getElementById("nome").value.trim();
      const telefone = document.getElementById("telefone").value.trim();
      const interesse = document.getElementById("interesse").value;

      if (!nome || !telefone || !interesse) {
        alert("Preencha todos os campos e selecione um tema de interesse.");
        return;
      }

      const numero = "5518996642021"; // Substitua pelo número oficial
      const mensagem = `Olá, meu nome é ${nome}.\nTelefone: ${telefone}\nTema de interesse: ${interesse}`;
      const url = `https://wa.me/${numero}?text=${encodeURIComponent(mensagem)}`;

      // Só quem pede o plano vira lead: emergência e banho e tosa não são venda de plano. O envio não segura o WhatsApp.
      if (interesse === "Plano de Saúde") {
        const lead = new FormData();
        lead.append("nome", nome);
        lead.append("telefone", telefone);
        navigator.sendBeacon("{{ path('portal_whatsapp_lead') }}", lead);
      }

      window.open(url, "_blank");
    });
  });

  function toggleForm() {
    const form = document.getElementById("formBox");
    form.style.display = (form.style.display === "block") ? "none" : "block";
  }
</script>



