  <form id="form-whats" style="padding: 16px;">
    <label for="nome" style="font-size: 14px;">Nome:</label><br>
    <input type="text" id="nome" required><br>

    <label for="telefone" style="font-size: 14px;">Telefone:</label><br>
    <input type="tel" id="telefone" pattern="^\(?\d{2}\)?\s?\d{4,5}-?\d{4}$" placeholder="(99) 99999-9999" required><br>

    <label for="interesse" style="font-size: 14px;">Tema de Interesse:</label><br>
    <select id="interesse" required>
      <option value="">Selecione uma opção</option>
      <option value="Emergência">Emergência</option>
      <option value="Banho e Tosa">Banho e Tosa</option>
      <option value="Plano de Saúde">Plano de Saúde</option>
      <option value="Loja">Loja</option>
    </select><br>

    <button id="btn-whatsapp" type="submit">Iniciar Conversa</button>
    <small style="display:block;margin-top:8px;font-size:12px;color:#666;">Se o tema for Plano de Saúde, guardamos seu nome e telefone para a equipe retornar o contato.</small>
  </form>
</div>






  <div class="container">
    <ul>
      <li>Todos os direitos reservados: <a href=""><img src="https://luzpropria.com.br/logo/logo-luz-propria.png"></a></li>
      <li>|</li>
      <li>
        <a class="icon" href="https://www.instagram.com/saofrancisco.vet/" target="_blank"><i class="fa fa-instagram"></i></a>
        <a class="icon" href="https://www.facebook.com/saofrancisco.vet.br/" target="_blank"><i class="fa fa-facebook"></i></a>
      </li>
    </ul>
  </div>
