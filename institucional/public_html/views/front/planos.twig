{% extends 'front/layout.twig' %}

{% block content %}
<link rel="stylesheet" href="{{asset('css/assinaturas.css?v=4')}}">

<section id="banner" class="interna plano">
  <div class="container box-info-banner">
    <div class="box-info">
      <div>
        <h2 data-aos="fade-up" data-aos-delay="200" data-aos-duration="800">{{clinica_info.title|raw}}</h2>
        {{clinica_info.body|raw}}
        <a class="btn-contato-banner" href="#planos" data-aos="fade-up" data-aos-delay="1000" data-aos-duration="800">Conheça os planos <i class="ri-arrow-down-line" aria-hidden="true"></i></a>
      </div>
    </div>
    <div class="box-info-img" data-aos="fade-up"  data-aos-delay="800" data-aos-duration="800">
      <img src="{{asset('imgs/banner-cao-4.png')}}" alt="Cuidado e proteção para seu pet">
    </div>
  </div>
</section>

<section id="quem-somos" class="interna planos-assinatura">
  <div class="container">
    <div id="planos" class="assinatura-intro">
      <span class="assinatura-kicker">MAIS CUIDADO EM CADA FASE</span>
      <h1>Escolha o plano do seu melhor amigo.</h1>
      <p>Compare os benefícios e conheça as condições de contratação para o seu pet.</p>
      {% if subscription_portal %}<a class="assinatura-access" href="{{subscription_portal}}">Já sou cliente · Acessar meus planos</a>{% endif %}
    </div>
    <div class="box-planos">

{% set aos = 0 %}
{# Benefits beyond this count (and every detail note) stay behind "ver mais"; hiding a single item is not worth the extra click. #}
{% set visiveis = 5 %}

      {% for item in planos %}
        {% set plano_n = loop.index %}
        {% set total = item.beneficios|length %}
        {% set recolher = total > visiveis + 1 %}
        {% set destaque = loop.index0 is same as(plano_destaque) %}
        <article class="plano{{ destaque ? ' plano-destaque' }}" data-aos="fade-up"  data-aos-delay="{{aos}}" data-aos-duration="800">
          {% if destaque %}<span class="plano-selo">Mais completo</span>{% endif %}
          <h3>{{item.title|striptags}}</h3>
          <div class="box-info-plano">
            {% if item.offer|default(null) %}
              <div class="assinatura-price">R$ {{(item.offer.price_cents / 100)|number_format(2, ',', '.')}}<span class="assinatura-ciclo">{{{'monthly':'/mês','annual':'/ano','one_time':' à vista'}[item.offer.billing_cycle]|default(' ' ~ item.offer.billing_cycle)}}</span>{% if item.offer.enrollment_fee_cents %}<small>Adesão: R$ {{(item.offer.enrollment_fee_cents / 100)|number_format(2, ',', '.')}}</small>{% endif %}</div>
            {% endif %}
            <div class="assinatura-card-action">
              {% if item.subscription_url %}
                <a class="assinatura-button" href="{{item.subscription_url}}" aria-label="Contratar {{item.title|striptags}}">Contratar este plano <span aria-hidden="true">→</span></a>
                <small>Confira valores e contrato antes de assinar.</small>
              {% else %}
                <a class="assinatura-button" href="#contato-planos">Falar com nossa equipe <span aria-hidden="true">→</span></a>
                <small>Nossa equipe ajuda você a escolher.</small>
              {% endif %}
            </div>
            <div class="plano-coberturas">
              <ul class="plano-lista" id="beneficios-plano-{{plano_n}}">
                {% for bene in item.beneficios %}
                  {% set inclusa = bene.included ?? true %}
                  <li class="{{ inclusa ? 'is-inclusa' : 'is-desconto' }}{{ recolher and loop.index > visiveis ? ' is-extra' }}">
                    <i class="{{ inclusa ? 'ri-check-line' : 'ri-percent-line' }}" aria-hidden="true"></i>
                    <span class="cobertura">
                      <span class="cobertura-nome">{{bene.title|raw}}</span>
                      {% if bene.tag is defined %}
                        {% set info = (bene.tag != 'Incluso' ? [bene.tag] : [])|merge(bene.waiting_days ? ['carência de ' ~ bene.waiting_days ~ ' dias'] : []) %}
                        {% if info %}<span class="cobertura-info">{{info|join(' · ')}}</span>{% endif %}
                        {% if bene.note %}<span class="cobertura-nota">{{bene.note}}</span>{% endif %}
                      {% elseif bene.body %}
                        <span class="cobertura-nota">{{bene.body|raw}}</span>
                      {% endif %}
                    </span>
                  </li>
                {% endfor %}
              </ul>
              {% if recolher %}
                <button type="button" class="plano-ver-mais" aria-expanded="true" aria-controls="beneficios-plano-{{plano_n}}" data-ver-mais="Ver todos os {{total}} benefícios" data-ver-menos="Ver menos" hidden><span class="plano-ver-mais-texto">Ver todos os {{total}} benefícios</span><i class="ri-arrow-down-s-line" aria-hidden="true"></i></button>
              {% endif %}
            </div>
          </div>
        </article>

        {% set aos = aos + 200 %}

        {% if aos > 400 %}
          {% set aos = 0 %}
        {% endif %}

      {% endfor %}



    </div>

    {% if comparativo|length %}
    {% set linhas_visiveis = 8 %}
    {% set recolher_linhas = comparativo|length > linhas_visiveis + 1 %}
    <p class="planos-atalho"><a href="#comparar-planos">Comparar todos os planos lado a lado <i class="ri-arrow-down-line" aria-hidden="true"></i></a></p>

    <section id="comparar-planos" class="planos-comparar" aria-labelledby="comparar-titulo">
      <div class="planos-comparar-intro">
        <span class="assinatura-kicker">COMPARE ANTES DE ESCOLHER</span>
        <h2 id="comparar-titulo">Todos os planos, lado a lado.</h2>
        <p>Veja o que cada plano inclui, os descontos e as carências de cada benefício.</p>
        <p class="comparar-dica" aria-hidden="true"><i class="ri-drag-move-2-line"></i> Arraste a tabela para o lado para ver todos os planos.</p>
      </div>
      <div class="comparar-tabela" role="region" aria-labelledby="comparar-titulo" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">Benefício</th>
              {% for item in planos %}
                <th scope="col"{% if loop.index0 is same as(plano_destaque) %} class="is-destaque"{% endif %}>
                  {% if loop.index0 is same as(plano_destaque) %}<span class="comparar-selo">Mais completo</span>{% endif %}
                  <strong>{{item.title|striptags}}</strong>
                  {% if item.offer|default(null) %}<span class="comparar-preco">R$ {{(item.offer.price_cents / 100)|number_format(2, ',', '.')}}{{ item.offer.billing_cycle == 'monthly' ? '/mês' }}</span>{% endif %}
                </th>
              {% endfor %}
            </tr>
          </thead>
          <tbody id="comparar-linhas">
            {% for linha in comparativo %}
              <tr{% if recolher_linhas and loop.index > linhas_visiveis %} class="is-extra"{% endif %}>
                <th scope="row">{{linha.name}}</th>
                {% for cell in linha.cells %}
                  <td{% if loop.index0 is same as(plano_destaque) %} class="is-destaque"{% endif %}>
                    {% if cell %}
                      {% set inclusa = cell.included ?? true %}
                      <span class="comparar-valor {{ inclusa ? 'is-inclusa' : 'is-desconto' }}"><i class="{{ inclusa ? 'ri-check-line' : 'ri-percent-line' }}" aria-hidden="true"></i>{{ cell.tag ?? 'Incluso' }}</span>
                      {% if cell.waiting_days|default(0) %}<small>Carência: {{cell.waiting_days}} dias</small>{% endif %}
                    {% else %}
                      <span class="comparar-nao" aria-hidden="true">—</span><span class="sr-only">Não incluso</span>
                    {% endif %}
                  </td>
                {% endfor %}
              </tr>
            {% endfor %}
          </tbody>
          {% if planos|filter(p => p.subscription_url)|length %}
          <tfoot>
            <tr>
              <td></td>
              {% for item in planos %}
                <td{% if loop.index0 is same as(plano_destaque) %} class="is-destaque"{% endif %}>{% if item.subscription_url %}<a class="comparar-contratar" href="{{item.subscription_url}}" aria-label="Contratar {{item.title|striptags}}">Contratar</a>{% endif %}</td>
              {% endfor %}
            </tr>
          </tfoot>
          {% endif %}
        </table>
      </div>
      {% if recolher_linhas %}
        <button type="button" class="plano-ver-mais comparar-ver-mais" aria-expanded="true" aria-controls="comparar-linhas" data-ver-mais="Ver comparação completa (+{{comparativo|length - linhas_visiveis}} benefícios)" data-ver-menos="Ver menos" hidden><span class="plano-ver-mais-texto">Ver comparação completa (+{{comparativo|length - linhas_visiveis}} benefícios)</span><i class="ri-arrow-down-s-line" aria-hidden="true"></i></button>
      {% endif %}
    </section>
    {% endif %}

    <div id="contato-planos" class="assinatura-contact"><h2>Quer ajuda para escolher?</h2><p>Converse com nossa equipe e encontre o cuidado adequado para seu pet.</p></div>
    {% include 'front/contato.twig' %}
  </div>
</section>

{% endblock %}

{% block js %}
<script>
  // Lists render complete; collapse only once JS is available so nothing is hidden without it.
  document.querySelectorAll('.plano-ver-mais').forEach(function (button) {
    const target = document.getElementById(button.getAttribute('aria-controls'));
    const label = button.querySelector('.plano-ver-mais-texto');
    if (!target) return;

    function toggle(open) {
      target.classList.toggle('is-recolhida', !open);
      button.setAttribute('aria-expanded', open ? 'true' : 'false');
      label.textContent = open ? button.dataset.verMenos : button.dataset.verMais;
    }

    toggle(false);
    button.hidden = false;

    button.addEventListener('click', function () {
      const open = button.getAttribute('aria-expanded') !== 'true';
      toggle(open);
      const box = target.closest('.plano, .planos-comparar');
      // Collapsing a long list can leave the reader far below its card; bring the card back into view.
      if (!open && box && box.getBoundingClientRect().top < 0) {
        window.scrollTo({ top: box.getBoundingClientRect().top + window.pageYOffset - 100, behavior: 'smooth' });
      }
      if (window.AOS) AOS.refresh();
    });
  });
</script>
{% endblock %}
