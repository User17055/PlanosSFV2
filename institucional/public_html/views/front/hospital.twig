{% extends 'front/layout.twig' %}

{% block content %}

<section id="banner" class="interna">
  <div class="container box-info-banner">
    <div class="box-info">
      <div>
        <h2 data-aos="fade-up" data-aos-delay="200" data-aos-duration="800">Serviços Médicos Veterinários</h2>
        <p data-aos="fade-up" data-aos-delay="400" data-aos-duration="800">Cirurgias em geral, exames laboratoriais, testes hormonais, planos de saúde, ultrassom, raio-x, hotelaria, atendimento 24hrs, UTI e ambulância veterinária.</p>
      </div>
    </div>
    <div class="box-info-img" data-aos="fade-up"  data-aos-delay="800" data-aos-duration="800">
      <img src="{{asset('imgs/banner-cao-2.png')}}">
    </div>
  </div>
</section>

<section id="quem-somos" class="interna">
  <div class="container">
    <div class="header" data-aos-anchor="#quem-somos" data-aos="fade-up" data-aos-duration="800">
      <h3>O cuidado que seu pet merece</h3>
    </div>
    <div class="box-servicos" data-aos="fade-up"  data-aos-delay="200" data-aos-anchor="#quem-somos" data-aos-duration="800">

      {% for item in servicos %}
        <div class="cada-servico">
          <div class="icon">
            <img src="{{path('imagem',{'path':'servicos','imagem':item.image})}}">
          </div>
          <div class="descricao">
            <h4>{{item.title|raw}}</h4>
            {{item.body|raw}}
          </div>
        </div>
      {% endfor %}



    </div>
    {% include 'front/contato.twig' %}
  </div>
</section>

{% endblock %}

