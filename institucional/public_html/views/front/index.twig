{% block js %}

<script type="text/javascript">
  var verifyCallback = function(response) {
    $('input[name="hiddenRecaptcha"]').val(response);
    console.log(response + 'jopachav-xD-22042019');
  };

  var onloadCallback = function() {
    grecaptcha.render('captcha', {
      'sitekey' : '6Lf0nwArAAAAAMxVryDS5I-7_A0Yi-am5OoGboW7',
      'callback' : verifyCallback,
      'theme' : 'light'
    });
  };

  $("#contato").validate({
    rules: {
      iNome: "required",
      iTelefone: "required",
      iCidade: "required",
      iMensagem: "required",
    },
    submitHandler: function(form){
      if (grecaptcha.getResponse() == '') {
        $('#captcha iframe').addClass('error');
        $('#captcha').append('<label class="error">Verificação obrigatória</label>');
      } else {

        $('#captcha').find('.error').remove();
        $('#captcha iframe').removeClass('error');
        form.submit();
      }
    }
  });

</script>

<script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit" async="" defer=""></script>


   {% set alertTypeAvaillable = [ 'info', 'success', 'warning', 'danger'] %}
            {% if site.session.flashbag is defined %}
                    {% for alertType in alertTypeAvaillable %}
                            {% for alert in site.session.flashBag.get(alertType) %}
                                            {% if alertType == 'success' %}
                                                    <script language="javascript">
                                                        swal("sucesso!", "Mensagem enviada com sucesso!", "success");
                                                    </script>
                                            {% endif %}
                            {% endfor %}
                    {% endfor %}
            {% endif %}

{% endblock %}

