{% extends 'front/layout.twig' %}

{% block content %}


<section id="banner" class="interna">
  <div class="container box-info-banner">
    <div class="box-info">
      <div>
        <h2 data-aos="fade-up" data-aos-delay="200" data-aos-duration="800">{{banho_tosa.title|raw}}</h2>
        <div class="scroll-ms">
          {{banho_tosa.body|raw}}
        </div>
        <a href="javascript:void(0)" onclick="$('html,body').animate({scrollTop: $('#quem-somos').offset().top - 50}, 1000);" class="btn">AGENDE UM HORÁRIO AGORA! </a>
      </div>
    </div>
    <div class="box-info-img" data-aos="fade-up"  data-aos-delay="800" data-aos-duration="800">
      <img src="{{asset('imgs/banner-cao-6.png')}}">
    </div>
  </div>
</section>

<section id="quem-somos" class="interna">
  <div class="container">

    {% include 'front/contato.twig' %}

  </div>
</section>

{% endblock %}

